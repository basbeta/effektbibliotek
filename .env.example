# PostgreSQL 18 (Coolify-hostet på Hetzner)
DATABASE_URL="postgresql://user:password@host:5432/effektbibliotek"

# iron-session
IRON_SESSION_SECRET="minst-32-tegn-tilfeldig-streng"

# App-URL brukt til å bygge lenker i e-post (godkjenningslenke, case-lenke). Kun server-side —
# IKKE bruk NEXT_PUBLIC_-prefiks her: Next.js bygger NEXT_PUBLIC_*-variabler statisk inn i koden
# ved build time (også i server-kode), så en runtime-only-endring ville aldri slå gjennom.
# request.url.origin er dessuten upålitelig bak Coolify/Traefik i API-routes — sett denne eksplisitt.
APP_URL="https://effektbibliotek.basbeta.no"

# Brevo SMTP (smtp-relay.brevo.com, port 587)
BREVO_SMTP_LOGIN="din-brevo-konto@example.com"
BREVO_SMTP_KEY="brevo-smtp-nokkel"
FROM_EMAIL="Effektbibliotek <effektbibliotek@basbeta.no>"

# Bugsink (Sentry-kompatibel feilsporing, selvhostet på errors.basbeta.no)
SENTRY_DSN="https://<key>@errors.basbeta.no/1"
NEXT_PUBLIC_SENTRY_DSN="https://<key>@errors.basbeta.no/1"

# Hetzner Object Storage (S3-kompatibel) — filopplasting til case-materiale (CR-027).
# Delt bucket med resten av basbeta-prosjektene (samme som brukes til database-backup) —
# denne appen skriver kun under prefiksen effektbibliotek/case-materiale/, se lib/storage.ts.
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
S3_REGION="fsn1"
S3_BUCKET="basbeta-backup"
S3_ACCESS_KEY_ID="din-access-key"
S3_SECRET_ACCESS_KEY="din-secret-key"
